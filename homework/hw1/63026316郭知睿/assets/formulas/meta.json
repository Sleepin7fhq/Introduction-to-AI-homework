 {
  "id": "p6_def",
  "w": 465.527,
  "h": 86.6884,
  "tex": "\\begin{aligned}\\int_0^1|f|^4dx&=\\sum_{n_1,n_2,n_3,n_4\\in S}\\int_0^1e^{2\\pi i(n_1+n_2-n_3-n_4)x}dx=\\sum_{n_1,\\dots,n_4\\in S}\\delta_{n_1+n_2,\\,n_3+n_4}\\\\&=\\sum_{(n_1,n_2)\\in S^2}\\#\\{(n_3,n_4)\\in S^2:\\ n_3+n_4=n_1+n_2\\}\\end{aligned}",
  "size": 15.5
 },
 {
