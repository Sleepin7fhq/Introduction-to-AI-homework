 {
  "id": "p5_deriv",
  "w": 435.52885,
  "h": 114.89795000000001,
  "tex": "\\begin{aligned}\\int_0^1|f(x)|^2dx&=\\int_0^1\\left(\\sum_{m\\in S}e^{2\\pi i m x}\\right)\\left(\\sum_{n\\in S}e^{-2\\pi i n x}\\right)dx\\\\&=\\sum_{m,n\\in S}\\int_0^1e^{2\\pi i(m-n)x}dx=\\sum_{m,n\\in S}\\delta_{mn}=N\\end{aligned}",
