[{"id": "cover_r2", "tex": "\\int_0^1|f|^2dx=N", "size": 17, "color": "#DCE8F7"}, {"id": "cover_r4", "tex": "\\int_0^1|f|^4dx=2N^2-N", "size": 17, "color": "#DCE8F7"}, {"id": "cover_r1", "tex": "\\int_0^1|f|dx\\geq\\frac{1}{2\\sqrt N}", "size": 17, "color": "#D9C08A"}, {"id": "p2_cond", "tex": "n_1+n_2=n_3+n_4\\ \\Longrightarrow\\ n_1\\in\\{n_3,n_4\\}", "size": 21}, {"id": "p2_f", "tex": "f(x)=\\sum_{n\\in S}e^{2\\pi i nx}", "size": 26}, {"id": "p2_ask", "tex": "(1)\\ \\int_0^1|f|^2dx\\qquad(2)\\ \\int_0^1|f|^4dx\\qquad(3)\\ \\int_0^1|f|dx\\geq\\frac{1}{2\\sqrt N}", "size": 13.5}, {"id": "p3_equiv", "tex": "\\Phi(a,b)=\\Phi(c,d)\\iff\\{a,b\\}=\\{c,d\\}", "size": 21}, {"id": "p3_fiber", "tex": "\\Phi^{-1}(s)=\\begin{cases}\\varnothing,&s\\notin S+S\\\\ \\{(a,a)\\},&s=2a\\\\ \\{(a,b),(b,a)\\},&s=a+b,\\ a\\neq b\\end{cases}", "size": 16}, {"id": "p4_l2", "tex": "|f(x)|^2=\\sum_{m,n\\in S}e^{2\\pi i(m-n)x}", "size": 19}, {"id": "p4_l4", "tex": "|f(x)|^4=\\sum_{n_1,n_2,n_3,n_4\\in S}e^{2\\pi i(n_1+n_2-n_3-n_4)x}", "size": 16}, {"id": "p4_R", "tex": "\\int_0^1|f|^4dx=\\#\\{(n_1,n_2,n_3,n_4)\\in S^4:\\ n_1+n_2=n_3+n_4\\}=:R", "size": 15}, {"id": "p5_deriv", "tex": "\\begin{aligned}\\int_0^1|f(x)|^2dx&=\\int_0^1\\left(\\sum_{m\\in S}e^{2\\pi i m x}\\right)\\left(\\sum_{n\\in S}e^{-2\\pi i n x}\\right)dx\\\\&=\\sum_{m,n\\in S}\\int_0^1e^{2\\pi i(m-n)x}dx=\\sum_{m,n\\in S}\\delta_{mn}=N\\end{aligned}", "size": 18.5}, {"id": "p5_orth", "tex": "\\int_0^1e^{2\\pi i kx}dx=\\begin{cases}1,&k=0\\\\ 0,&k\\neq0\\end{cases}", "size": 15}, {"id": "p5_res", "tex": "\\int_0^1|f(x)|^2dx=N", "size": 19}, {"id": "p6_def", "tex": "\\begin{aligned}\\int_0^1|f|^4dx&=\\sum_{n_1,n_2,n_3,n_4\\in S}\\int_0^1e^{2\\pi i(n_1+n_2-n_3-n_4)x}dx=\\sum_{n_1,\\dots,n_4\\in S}\\delta_{n_1+n_2,\\,n_3+n_4}\\\\&=\\sum_{(n_1,n_2)\\in S^2}\\#\\{(n_3,n_4)\\in S^2:\\ n_3+n_4=n_1+n_2\\}\\end{aligned}", "size": 15.5}, {"id": "p6_final", "tex": "R=\\underbrace{N}_{n_1=n_2}+\\underbrace{2N(N-1)}_{n_1\\neq n_2}=2N^2-N", "size": 20}, {"id": "p7_theta", "tex": "\\frac{1}{2}=\\theta\\cdot1+(1-\\theta)\\cdot\\frac{1}{4}\\ \\Longrightarrow\\ \\theta=\\frac{1}{3}", "size": 17}, {"id": "p7_lemma", "tex": "\\|f\\|_2\\leq\\|f\\|_1^{1/3}\\|f\\|_4^{2/3}\\quad\\iff\\quad\\int_0^1|f|dx\\geq\\frac{\\left(\\int_0^1|f|^2dx\\right)^{3/2}}{\\left(\\int_0^1|f|^4dx\\right)^{1/2}}", "size": 17}, {"id": "p8_holder", "tex": "\\begin{aligned}\\int_0^1|f|^2dx&=\\int_0^1|f|^{2/3}\\cdot|f|^{4/3}dx\\\\&\\leq\\left(\\int_0^1|f|dx\\right)^{2/3}\\left(\\int_0^1|f|^4dx\\right)^{1/3}\\end{aligned}", "size": 18}, {"id": "p8_chain1", "tex": "N\\leq I^{2/3}(2N^2-N)^{1/3}\\ \\Longrightarrow\\ N^3\\leq I^2(2N^2-N)\\ \\Longrightarrow\\ I^2\\geq\\frac{N^2}{2N-1}", "size": 16.5}, {"id": "p8_chain2", "tex": "I\\geq\\frac{N}{\\sqrt{2N-1}}\\geq\\frac{N}{\\sqrt{2N}}=\\sqrt{\\frac{N}{2}}\\geq\\frac{1}{2\\sqrt N}", "size": 20}, {"id": "p8_res", "tex": "\\int_0^1|f|dx\\geq\\frac{1}{2\\sqrt N}", "size": 19}, {"id": "p8_strong", "tex": "\\int_0^1|f|dx\\geq\\frac{N}{\\sqrt{2N-1}}\\geq\\sqrt{\\frac{N}{2}}", "size": 15}, {"id": "p9_sum", "tex": "\\int_0^1|f|^2dx=N\\qquad\\int_0^1|f|^4dx=2N^2-N\\qquad\\int_0^1|f|dx\\geq\\frac{1}{2\\sqrt N}", "size": 14}, {"id": "p10_l2", "tex": "\\int_0^1|f|^2dx=N", "size": 21, "color": "#FFFFFF"}, {"id": "p10_l4", "tex": "\\int_0^1|f|^4dx=2N^2-N", "size": 21, "color": "#FFFFFF"}, {"id": "p10_l1", "tex": "\\int_0^1|f|dx\\geq\\frac{1}{2\\sqrt N}", "size": 21, "color": "#D9C08A"}]