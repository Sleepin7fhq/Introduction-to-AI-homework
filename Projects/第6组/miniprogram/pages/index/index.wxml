<!-- 全屏相机 + 自朗读式操作区：不依赖视觉定位，任意位置长按即可拍摄 -->
<view class="stage">
  <camera
    wx:if="{{cameraReady}}"
    class="camera"
    device-position="back"
    flash="off"
    resolution="high"
    binderror="onCameraError"
  ></camera>

  <view wx:else class="camera placeholder">
    <text class="placeholder-text">正在启动相机…</text>
  </view>

  <!-- 触达即反馈：震动 + 音效 + 播报按钮名称 -->
  <view
    class="hit-area"
    bindtouchstart="onButtonTouch"
    bindtap="onTapShoot"
    bindlongpress="onLongPressTalk"
    aria-role="button"
    aria-label="拍摄键，轻点拍照，长按说话"
  >
        <view class="hint-bar">
          <text class="hint-text">{{statusText}}</text>
          <text class="hint-sub" wx:if="{{hintText}}">{{hintText}}</text>
        </view>
  </view>

  <view
    class="corner"
    bindtouchstart="onKeyTouch"
    bindtap="onTapHelp"
    data-label="帮助键"
    aria-role="button"
    aria-label="帮助键，轻点听取使用方法"
  >
    <text class="corner-text">?</text>
  </view>
</view>
