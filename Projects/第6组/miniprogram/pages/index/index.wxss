.stage {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000;
  overflow: hidden;
}

.camera {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  color: #9a9a9a;
  font-size: 32rpx;
}

/* 全屏可触达区域：视障用户无需精确瞄准某个小按钮 */
.hit-area {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 42%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0));
}

.hint-bar {
  padding: 24rpx 40rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
}

.hint-text {
  color: #ffffff;
  font-size: 34rpx;
  letter-spacing: 1rpx;
}

/* 重拍原因等详细提示：语音不可用时用户仍可读屏获取 */
.hint-sub {
  display: block;
  margin-top: 8rpx;
  color: #ffd76e;
  font-size: 28rpx;
  line-height: 1.5;
}

.corner {
  position: absolute;
  top: 60rpx;
  right: 48rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.corner-text {
  color: #ffffff;
  font-size: 44rpx;
}
