# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Local configuration and credentials (examples are safe to commit)
.env
.env.*
!.env.example
*.pem
*.key
.netlify/
.aws/

# Browser profiles and machine-specific diagnostics
.browser-check/
*browser-profile*/
*.log
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local code and screenshots produced during use
/web/data/custom*.json
/web/data/llm*.json
/public-release/workbench-checked-*.png
/public-release/netlify-index-check.json

# Rebuildable transport files and local tunnel tools
/public-release/**/*.gz
/public-release/*.zip
/public-release/*.exe
/web/vendor/pyodide/
/web/runtime/
/node_modules/
/coverage/
