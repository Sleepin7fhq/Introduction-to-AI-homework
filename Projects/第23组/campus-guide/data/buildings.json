      {"id": "side_photo", "title": "中大院侧墙实拍（中大院-侧墙.jpg）", "url": ""},
      {"id": "S1", "title": "东南大学校友总会《四牌楼校区》", "url": "https://seuaa.seu.edu.cn/2023/1228/c51495a477423/pagem.htm"},
      {"id": "S2", "title": "东南大学建筑学院《紫气东南》校园演变图史", "url": "https://arch.seu.edu.cn/2022/0610/c9118a411434/page.htm"},
      {"id": "S3", "title": "东南大学档案馆 · 沈国尧《忆思四牌楼》", "url": "https://archives.seu.edu.cn/2015/0602/c799a125472/pagem.htm"}
    ],
    "facts": [
      {"id": "origin", "text": "中大院原名生物馆，由李宗侃设计，1929年落成。", "keywords": ["原名", "原先", "原来", "以前", "前身", "生物馆", "谁设计", "设计", "李宗侃", "建于", "始建", "落成", "建成", "建造", "哪年建", "哪一年建", "什么时候建", "何时建", "1929"], "source_ids": ["S1", "S2"]},
      {"id": "style", "text": "中大院采用西方古典建筑形式，南入口的四根圆柱属于爱奥尼柱式。", "keywords": ["柱子", "柱式", "柱头", "爱奥尼", "风格", "古典", "南向", "朝向"], "source_ids": ["S1"]},
      {"id": "academic_history", "text": "这里曾是生物学系的办公场所，生物学家秉志曾在这里办公。", "keywords": ["生物学系", "秉志", "谁在这里", "谁在此", "谁办公", "最初用途", "原用途", "以前做什么"], "source_ids": ["S1"]},
      {"id": "expansion_dates", "text": "扩建的具体年份有两种记载。校友总会写的是1957年扩建两翼，建筑学院的《紫气东南》图注和档案馆刊载的沈国尧《忆思四牌楼》都记为1958年。", "keywords": ["扩建", "1957", "1958", "年份争议"], "source_ids": ["S1", "S2", "S3"]},
      {"id": "later_history", "text": "1952年院系调整后，这座楼曾用作南京工学院的行政办公楼。20世纪50年代后期，大楼扩建，改称中大院。", "keywords": ["院系调整", "行政", "办公楼", "校部", "1952", "更名", "改名", "改称", "得名", "50年代", "五十年代"], "source_ids": ["S1", "S2", "S3"]},
      {"id": "architecture_department", "text": "据沈国尧回忆，建筑系于1958年迁入中大院。", "keywords": ["建筑系", "迁入", "搬入", "搬迁", "搬进"], "source_ids": ["S3"]},
      {"id": "remodeling", "text": "建筑学院图史记载，生物馆在1933年有过一次改建。", "keywords": ["1933", "改建", "改造"], "source_ids": ["S2"]},
      {"id": "front", "text": "从正门前抬头看，四根浅色圆柱上方是三角形山花，山花下的横带上写着“中大院”三个金字。", "keywords": ["正门", "几根", "多少根", "题字", "金字", "山花", "三角"], "source_ids": ["front_photo"]},
      {"id": "side", "text": "沿侧墙看去，屋檐下的长方形窗排成一行，藤蔓沿墙面一直攀到窗边。", "keywords": ["侧面", "侧墙", "窗", "藤", "屋檐"], "source_ids": ["side_photo"]},
      {"id": "capitals", "text": "走近正门，可以看到圆柱的柱头两端各有一处向内卷曲的装饰。", "keywords": ["柱头", "柱顶", "装饰", "卷涡", "花纹"], "source_ids": ["front_photo"]},
      {"id": "steps", "text": "宽台阶横跨正门，入口就在中间两根圆柱之间，门洞四周有一圈浅色门框。", "keywords": ["台阶", "入口", "门框", "进门"], "source_ids": ["front_photo"]}
    ]
  },
  {
    "id": "B",
    "name": "体育馆",
    "placeholder": false,
    "visual_cues": ["门廊上方的半圆形灰砖墙面有金色的“體育館”题字", "两侧楼梯通向中央平台，门廊前有两根圆柱", "正面高拱窗顶部有扇形窗格，侧墙成组排列浅色窗框"],
    "reference_images": ["体育馆-正面.jpg", "体育馆-侧墙.jpg"],
    "guide_fact_ids": ["construction", "stairs", "tagore", "inscription", "location_structure", "arched_window"],
    "sources": [
      {"id": "front_photo", "title": "体育馆正面实拍（体育馆-正面.jpg）", "url": ""},
      {"id": "side_photo", "title": "体育馆侧墙实拍（体育馆-侧墙.jpg）", "url": ""},
      {"id": "S4", "title": "东南大学建筑学院《校园健身中心》课程材料 · 基地概况", "url": "https://arch.seu.edu.cn/2017/0628/c9122a192463/page.htm"},
      {"id": "S1", "title": "东南大学校友总会《四牌楼校区》", "url": "https://seuaa.seu.edu.cn/2023/1228/c51495a477423/pagem.htm"}
    ],
    "facts": [
      {"id": "construction", "text": "四牌楼校区的老体育馆始建于1922年，1923年落成。", "keywords": ["始建", "动工", "开工", "落成", "建成", "建于", "建造", "哪年建", "哪一年建", "什么时候建", "何时建", "1922", "1923"], "source_ids": ["S4", "S1"]},
      {"id": "location_structure", "text": "老体育馆位于校区西北部，坐西朝东，南北对称，共三层。建筑学院资料记载，馆内采用青砖木结构、钢组合屋架和木楼地板。", "keywords": ["位置", "在哪里", "哪一侧", "朝向", "坐向", "对称", "几层", "多少层", "结构", "木楼", "材料", "屋架", "地板", "西北"], "source_ids": ["S4"]},
      {"id": "entrance", "text": "老体育馆的入口门廊采用西方古典柱式。建筑学院介绍这处场地时，还提到了周边的梅庵、工艺实习场和六朝松。", "keywords": ["柱式", "柱廊", "门廊风格", "周边", "附近", "梅庵", "工艺实习场", "六朝松"], "source_ids": ["S4"]},
      {"id": "tagore", "text": "1924年，泰戈尔在徐志摩陪同下来到体育馆演讲。", "keywords": ["泰戈尔", "徐志摩", "演讲", "演说", "诗人", "文化活动", "1924"], "source_ids": ["S1"]},
      {"id": "design_brief", "text": "6000平方米和攀岩项目出自建筑学院2017年的课程任务书，描述的是学生要设计的健身中心。今天馆内有哪些设施，还需要场馆资料确认。", "keywords": ["6000", "六千", "攀岩", "课程任务", "学生设计", "健身中心"], "source_ids": ["S4"]},
      {"id": "historical_area", "text": "校友总会写老体育馆总面积为2317平方米。建筑学院2017年课程材料对当时场地的描述是建筑面积约2400平方米。", "keywords": ["面积", "多少平方米", "多大", "2317", "2400"], "source_ids": ["S1", "S4"]},
      {"id": "inscription", "text": "抬头看正门上方，半圆形的灰砖墙面上排着三个金字，从右向左读作“體育館”。", "keywords": ["题字", "馆名", "金字", "怎么读", "繁体", "半圆"], "source_ids": ["front_photo"]},
      {"id": "stairs", "text": "门前的两段楼梯从左右两侧升到同一个平台，平台后方的两根圆柱托起门廊。", "keywords": ["台阶", "楼梯", "平台", "圆柱", "门廊", "入口"], "source_ids": ["front_photo"]},
      {"id": "arched_window", "text": "在正面照片的左侧，一扇高拱窗伸到三角形山花下方，拱顶内的窗格像扇面一样展开。", "keywords": ["拱窗", "窗格", "扇形", "山花"], "source_ids": ["front_photo"]},
      {"id": "side", "text": "转到侧面，青灰色砖墙上分层排列着浅色窗框的长方形窗。沿屋檐望去，还能看到一排间隔整齐的托架。", "keywords": ["侧面", "侧墙", "窗框", "长方形窗", "屋檐", "托架", "砖墙"], "source_ids": ["side_photo"]}
    ]
  },
  {
    "id": "C",
    "name": "四牌楼校区图书馆",
    "placeholder": false,
    "visual_cues": ["入口门檐正面有三块深色方牌，每块一个金字，合读为“图书馆”", "正面浅色竖带分隔多层窗列，屋檐平直并向外挑出", "侧墙的横向长窗由深色窗框分格"],
    "reference_images": ["四牌楼校区图书馆-正面.jpg", "四牌楼校区图书馆-侧墙.jpg"],
    "guide_fact_ids": ["completion", "sign", "school_spirit", "facade", "side_windows", "shelves"],
    "sources": [
      {"id": "front_photo", "title": "四牌楼校区图书馆正面实拍（“四牌楼校区图书馆-正面.jpg”）", "url": ""},
      {"id": "side_photo", "title": "四牌楼校区图书馆侧墙实拍（“四牌楼校区图书馆-侧墙.jpg”）", "url": ""},
      {"id": "S2", "title": "东南大学建筑学院《紫气东南》校园演变图史", "url": "https://arch.seu.edu.cn/2022/0610/c9118a411434/page.htm"},
      {"id": "S5", "title": "东南大学校史馆《校训、校风》", "url": "https://history.seu.edu.cn/18738/list.htm"},
      {"id": "S1", "title": "东南大学校友总会《四牌楼校区》", "url": "https://seuaa.seu.edu.cn/2023/1228/c51495a477423/pagem.htm"},
      {"id": "S3", "title": "东南大学档案馆 · 沈国尧《忆思四牌楼》", "url": "https://archives.seu.edu.cn/2015/0602/c799a125472/pagem.htm"},
      {"id": "S6", "title": "东南大学转载《江南时报》关于校内逸夫楼的报道", "url": "https://www.seu.edu.cn/2014/0108/c124a52633/page.htm"}
    ],
    "facts": [
      {"id": "distinction", "text": "四牌楼校区1985年落成的是图书馆新楼。较早的孟芳图书馆，校友总会记为1923年落成，建筑学院图史标作1924年，沈国尧的回忆也记为1924年竣工。", "keywords": ["孟芳", "老图书馆", "老馆", "区别", "同一座", "1923", "1924"], "source_ids": ["S1", "S2", "S3"]},
      {"id": "completion", "text": "四牌楼校区的图书馆新楼于1985年落成，当时学校名为南京工学院。", "keywords": ["落成", "建成", "建于", "建造", "哪年建", "哪一年建", "什么时候建", "何时建", "1985", "当时校名", "当时叫什么", "南京工学院"], "source_ids": ["S2", "S5"]},
      {"id": "school_spirit", "text": "据校史馆记载，新馆落成时，学校将“严谨、求实、团结、奋进”八字安放在正立面。南京工学院时期形成的这八字校风，后来一直为东南大学沿用。", "keywords": ["八字", "八个字", "校风", "外墙的字", "外墙上的字", "墙上写", "外墙金字", "严谨", "求实", "团结", "奋进"], "source_ids": ["S5"]},
      {"id": "identification", "text": "正面实拍可见入口的“图书馆”方牌，立面上还能辨出“求实”“团结”等金字。它们与校史馆关于新馆正立面校风题字的记载吻合，这组照片展示的是四牌楼校区图书馆。", "keywords": ["怎么判断", "判断依据", "识别依据", "哪座图书馆", "哪个图书馆", "为什么叫", "如何确认", "拍的是哪", "原标注"], "source_ids": ["front_photo", "S5"]},
      {"id": "name_check", "text": "这座建筑在本导览中统一称为“四牌楼校区图书馆”。尚未找到说明其捐资情况的可靠材料。", "keywords": ["正式名称", "正式名", "原标注", "馆名", "别名", "别称", "冠名", "叫逸夫", "是逸夫", "邵逸夫", "捐", "出资", "资助"], "source_ids": ["S2", "S6"]},
      {"id": "sign", "text": "从门前台阶抬头看，玻璃入口上方的门檐正面并排镶着三块深色方牌，每块一个金字，连起来读作“图书馆”。", "keywords": ["正门", "入口", "方牌", "牌匾", "题字", "金字", "馆名", "台阶"], "source_ids": ["front_photo"]},
      {"id": "side_windows", "text": "转到侧面，浅色墙面上的长窗一层层横向排开，深色窗框把玻璃分成数格。", "keywords": ["侧墙", "侧面", "长窗", "窗框", "窗户形状"], "source_ids": ["side_photo"]},
      {"id": "facade", "text": "从正面往上看，一道道浅色竖带把多层窗列分开，一直延伸到平直、向外挑出的屋檐下。", "keywords": ["正面", "立面", "竖带", "窗列", "屋顶", "屋檐"], "source_ids": ["front_photo"]},
      {"id": "shelves", "text": "从侧墙的一排玻璃窗望进去，可以看到书架上一册册竖放的书，书脊朝向窗外。", "keywords": ["窗里", "窗内", "透过", "书架", "书脊"], "source_ids": ["side_photo"]}
    ]
  }
]
